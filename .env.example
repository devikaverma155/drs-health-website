# Environment Configuration Example
# Copy this to .env.local for development or set in Vercel Dashboard for production

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL="https://9gk.22b.myftpupload.com"
NEXT_PUBLIC_API_URL="https://9gk.22b.myftpupload.com"

# ============================================
# WOOCOMMERCE REST API
# ============================================
# The WordPress site's WooCommerce API endpoint
NEXT_PUBLIC_WC_API_URL="https://9gk.22b.myftpupload.com/wp-json/wc/v3"

# WooCommerce REST API credentials (from WordPress admin)
# Store → Settings → Advanced → REST API
WC_CONSUMER_KEY="ck_3cb406be5e115bf1f9b5bb10cf456661cfda0c94"
WC_CONSUMER_SECRET="cs_aefccb6cb560023948cb4e8c2fcaa61dbfef0b6e"

# Checkout URL for add-to-cart redirects
NEXT_PUBLIC_WC_CHECKOUT_URL="https://9gk.22b.myftpupload.com/checkout"

# Shared secret for ensure-user endpoint (create wp_users at checkout). Must match WordPress wp-config (DRS_ENSURE_USER_SECRET or DRS_ORDER_EMAIL_SECRET). See docs/wordpress-ensure-user.php.
WC_ORDER_EMAIL_SECRET=""

# ============================================
# NEXTAUTH CONFIGURATION (Admin Panel)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_secret_here"

# Full URL of your application (must match deployment URL)
NEXTAUTH_URL="https://drshealth.in"

# ============================================
# DATABASE CONFIGURATION (Prisma)
# ============================================
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/drshealthdb
#
# Supabase + Prisma:
# - Use Transaction pooler (port 6543) with ?pgbouncer=true — NOT Session pooler on 5432 (avoids MaxClientsInSessionMode).
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:port/database"

# ============================================
# RAZORPAY (Pay Now - UPI | Card | NetBanking)
# ============================================
# Set to "true" only when Razorpay is configured for production. Use "false" to show
# only Cash on Delivery (COD) and hide Razorpay on the live site.
NEXT_PUBLIC_ENABLE_RAZORPAY="false"

# From Razorpay Dashboard → API Keys (use Live for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
