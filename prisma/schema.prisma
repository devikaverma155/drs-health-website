generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("admin")
}

model User {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String?
  email     String?   @unique
  phone     String?
  role      String?   @default("employee")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("users")
}

model Employee {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String?
  email       String?
  phone       String?
  designation String?
  department  String?
  joiningDate DateTime? @map("joining_date") @db.Date
  salary      Decimal?  @db.Decimal
  status      String?   @default("active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("employees")
}

model EmployeeDocument {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  employeeId   String?   @map("employee_id") @db.Uuid
  documentType String?   @map("document_type")
  fileUrl      String?   @map("file_url")
  uploadedAt   DateTime? @default(now()) @map("uploaded_at") @db.Timestamp(6)

  @@map("employee_documents")
}

model RawMaterialBuyer {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyName      String?   @map("company_name")
  contactPerson    String?   @map("contact_person")
  phone            String?
  email            String?
  materialRequired String?   @map("material_required")
  quantity         String?
  location         String?
  notes            String?
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("raw_material_buyers")
}

model RawMaterialOrder {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  buyerId         String?   @map("buyer_id") @db.Uuid
  orderDate       DateTime? @default(now()) @map("order_date") @db.Timestamp(6)
  materialType    String?   @map("material_type")
  quantity        String?
  unit            String?
  price           Decimal?  @db.Decimal(10, 2)
  supplierName    String?   @map("supplier_name")
  supplierContact String?   @map("supplier_contact")
  deliveryDate    DateTime? @map("delivery_date") @db.Date
  status          String?   @default("pending")
  notes           String?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([buyerId], map: "idx_raw_material_orders_buyer_id")
  @@index([orderDate], map: "idx_raw_material_orders_order_date")
  @@index([status], map: "idx_raw_material_orders_status")
  @@map("raw_material_orders")
}

model Lead {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String?
  phone       String?
  email       String?
  source      String?
  status      String?   @default("new")
  companyName String?   @map("company_name")
  message     String?
  city        String?
  state       String?
  country     String?
  assignedTo  String?   @map("assigned_to") @db.Uuid
  priority    String?   @default("medium")
  tags        String[]
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  activities LeadActivity[]

  @@map("leads")
}

model LeadDetail {
  id         String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId     String? @map("lead_id") @db.Uuid
  fieldKey   String? @map("field_key")
  fieldValue String? @map("field_value")

  @@map("lead_details")
}

model LeadActivity {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId    String?   @map("lead_id") @db.Uuid
  lead      Lead?     @relation(fields: [leadId], references: [id])
  action    String?
  note      String?
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("lead_activity")
}

model ClinicPatient {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String?
  phone          String?
  email          String?
  age            Int?
  gender         String?
  condition      String?
  assignedDoctor String?   @map("assigned_doctor")
  notes          String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("clinic_patients")
}

model WhatsAppMessage {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId    String?   @map("lead_id") @db.Uuid
  phone     String?
  direction String?
  message   String?
  status    String?
  sentAt    DateTime? @default(now()) @map("sent_at") @db.Timestamp(6)

  @@map("whatsapp_messages")
}

model WebsiteContent {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sectionKey String?   @map("section_key")
  title      String?
  subtitle   String?
  imageUrl   String?   @map("image_url")
  ctaText    String?   @map("cta_text")
  ctaLink    String?   @map("cta_link")
  isActive   Boolean?  @default(true) @map("is_active")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("website_content")
}

model CartEvent {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerName String?   @map("customer_name")
  email        String?
  phone        String?
  productIds   Json?     @map("product_ids")
  cartValue    Decimal?  @map("cart_value") @db.Decimal
  status       String?   @default("active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("cart_events")
}

model HeroSlide {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  headline          String
  subtext           String?
  ctaLabel          String?   @map("cta_label")
  ctaHref           String?   @map("cta_href")
  secondaryCtaLabel String?   @map("secondary_cta_label")
  secondaryCtaHref  String?   @map("secondary_cta_href")
  imageUrl          String?   @map("image_url")
  imageAlt          String?   @map("image_alt")
  sortOrder         Int       @default(0) @map("sort_order")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("hero_slides")
}

model ComboOffer {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String
  description   String?
  imageUrl      String?   @map("image_url")
  price         String?
  originalPrice String?   @map("original_price")
  discount      String?
  ctaLabel      String?   @map("cta_label")
  ctaHref       String?   @map("cta_href")
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("combo_offers")
}
